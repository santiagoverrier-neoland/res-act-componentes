---
import { Image } from 'astro:assets';
const { imagen,nombre, puesto, experiencia, layout } = Astro.props 
---

<div class="card">
    <h2>{nombre}</h2>
    <Image 
        src={imagen}
        alt={nombre}
        layout={layout}
    />
    <strong>{puesto}</strong>
    <p>{experiencia}</p>
</div>