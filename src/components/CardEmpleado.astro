---
const { name, email, website, id } = Astro.props;
---

<style>
  .card {
    border: dotted 1px darkslategray;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  .card h2 {
    flex-grow: 2;
  }

  img {
    width: 100%;
    height: auto;
  }
</style>

<div class="card">
  <h2>{name}</h2>
  <img src={"https://picsum.photos/300/300?random=" + id} alt="" />
  <strong>{email}</strong>
  <a href={"https://" + website}>{website}</a>
</div>
