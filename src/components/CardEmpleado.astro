---
import { Image } from 'astro:assets';
const { imagen,nombre, puesto, experiencia, layout } = Astro.props 
/*
imagen="../assets/1.jpeg"
nombre="Ana Gómez"
puesto="Frontend Developer"
experiencia="3 años"
layout="constrained"

*/
---

<div class="card">
    <h2>{nombre}</h2>
    <Image 
        src={imagen}
        alt={nombre}
        layout={layout} 
    />
    <br>
    <strong>{puesto}</strong>
    <p>{experiencia} años</p>
</div>