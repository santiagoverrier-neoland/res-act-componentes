---
import CardEmpleado from "../components/CardEmpleado.astro"
import { Picture } from 'astro:assets';
import hero from "../assets/hero.jpg"

// Avatares
import persona1 from "../assets/1.jpeg"
import persona2 from "../assets/2.jpeg"
import persona3 from "../assets/3.jpeg"
import persona4 from "../assets/4.jpeg"
import persona5 from "../assets/5.jpeg"

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<Picture 
			src={hero}
			alt="Encabezado"
			layout='full-width'
			formats={['avif', 'webp']} 
		/>
		<h1>Astro</h1>

		<CardEmpleado
			imagen={persona1}
			nombre="Ana Gómez"
			puesto="Frontend Developer"
			experiencia="3 años"
		/>
		<CardEmpleado
			imagen={persona2}
			nombre="Martín López"
			puesto="Backend Developer"
			experiencia="5 años"
		/>
		<CardEmpleado
			imagen={persona3}
			nombre="Sofía Pérez"
			puesto="Diseñadora UX/UI"
			experiencia="2 años"
		/>
		<CardEmpleado
			imagen={persona4}
			nombre="Juan Rodríguez"
			puesto="Full Stack"
			experiencia="4 años"
		/>
		<CardEmpleado
			imagen={persona5}
			nombre="Carla Fernandez"
			puesto="Project Manager"
			experiencia="6 años"
		/>
	</body>
</html>
